{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [],
  "instructions": [
    "C:\\Users\\GBC_PC\\.config\\opencode\\brainvibes\\gemini.md"
  ],
  "provider": {
    "idihore": {
      "name": "Hinata",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://hinata.idihore.id/llm/v1"
      },
      "models": {
        "hinata": {
          "name": "hinata",
          "reasoning": true,
          "limit": {
            "context": 262144,
            "output": 8192
          }
        }
      }
    }
  },
  // OpenCode MCP Configuration
  // AI and IDE integrations for Model Context Protocol
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "X-Context7-Client-IDE": "opencode|gemini|antigravity|cursor|copilot"
      }
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "memory": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-memory"],
      "environment": {
        "MEMORY_FILE_PATH": "C:\\Users\\GBC_PC\\.gemini\\brainvibes-memory.json"
      }
    },
    "filesystem": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-filesystem", "C:\\XAMPP\\htdocs", "C:\\Users\\GBC_PC\\.gemini", "C:\\Users\\GBC_PC\\.config\\opencode", "G:\\mymodel\\opencode"]
    },
    "time": {
      "type": "local",
      "command": ["C:\\Users\\GBC_PC\\.local\\bin\\uvx.exe", "mcp-server-time"],
      "environment": {
        "LOCAL_TIMEZONE": "Asia/Jakarta"
      }
    },
    "fetch": {
      "type": "local",
      "command": ["C:\\Users\\GBC_PC\\.local\\bin\\uvx.exe", "mcp-server-fetch"]
    }
  }
}
