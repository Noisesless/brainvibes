{
  "mcpServers": {
    "codebase-memory": {
      "command": "codebase-memory-mcp"
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    }
  },
  "mcp": {
    "codebase-memory": {
      "type": "local",
      "command": ["codebase-memory-mcp"]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "X-Context7-Client-IDE": "gemini|antigravity|cursor|copilot"
      }
    }
  }
}
