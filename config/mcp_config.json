{
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "X-Context7-Client-IDE": "gemini|antigravity|cursor|copilot"
      }
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "memory": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-memory"],
      "environment": {
        "MEMORY_FILE_PATH": "C:\\Users\\GBC_PC\\.gemini\\brainvibes-memory.json"
      }
    },
    "filesystem": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-filesystem", "C:\\xampp\\htdocs", "C:\\Users\\GBC_PC\\.gemini"]
    },
    "time": {
      "type": "local",
      "command": ["C:\\Users\\GBC_PC\\.local\\bin\\uvx.exe", "mcp-server-time"],
      "environment": {
        "LOCAL_TIMEZONE": "Asia/Jakarta"
      }
    },
    "fetch": {
      "type": "local",
      "command": ["C:\\Users\\GBC_PC\\.local\\bin\\uvx.exe", "mcp-server-fetch"]
    }
  }
}
