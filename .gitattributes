# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Shell scripts must strictly use LF line endings on all platforms
*.sh text eol=lf

# PowerShell scripts use CRLF for Windows compatibility
*.ps1 text eol=crlf

# Documentation, configs, and web formats use LF
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
